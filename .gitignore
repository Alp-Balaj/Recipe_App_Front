# Dependencies
# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, and
# parallel-work git worktrees symlink this to the main checkout's copy rather
# than paying npm ci per tree — a symlink git then reported as untracked, one
# `git add -A` away from committing an absolute path that resolves on exactly
# one machine.
node_modules

# Build output
dist/
dist-ssr/

# Vite
*.local
.vite/

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent scratch: subagent-driven-development ledgers, briefs, review packages.
.superpowers/
